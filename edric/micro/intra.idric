module Intra

%default total

infixr 9 ∘

(∘) : (b → c) → (a → b) → a → c
(f ∘ g) x = f (g x)

prefix_sums : Num a ⇒ a → List a → List a
prefix_sums _ [] = []
prefix_sums total (x :: xs) =
  let next = total + x
  in next :: prefix_sums next xs

sum_values : Num a ⇒ List a → a
sum_values = foldl (+) 0

scan_reduce_row : List Float → Float
scan_reduce_row = sum_values ∘ prefix_sums 0

scan_reduce : List (List Float) → List Float
scan_reduce = map scan_reduce_row

-- Futhark benchmark shape: [1000000][6]f32.
-- This temporary List carrier preserves order and Float32 arithmetic only;
-- it is not the eventual benchmark storage representation.
example_row : List Float
example_row = [1, 2, 3, 4, 5, 6]

example_result : Float
example_result = scan_reduce_row example_row
